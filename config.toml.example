# Copy to config.toml (gitignored) and fill in your provider's values.
# Used by prototype/jev_contract.py for live provider tests.

# provider: "hosted" (jevtypesafeai.com) or "cloudflare"
# model:    "jev-latest" (or pinned "jev-1.13.0") on hosted;
#           "typesafe/jev" when provider = "cloudflare"
[jev]
provider = "hosted"
url = "https://jevtypesafeai.com/api/v1/decide"   # hosted route only
# NEVER put a real key in THIS file — it is committed. Real values go in config.toml (gitignored).
api_key = "jv_live_xxx"                            # hosted route only (jv_live_…)
model = "jev-latest"

# cloudflare route: POST /client/v4/accounts/{account_id}/ai/run, model typesafe/jev
# Keys mirror the env vars (CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN) so config
# and environment stay interchangeable. wrangler whoami → account id,
# wrangler auth token → token.
# NEVER put real values in THIS file — it is committed. Real values go in config.toml (gitignored).
[cloudflare]
CLOUDFLARE_ACCOUNT_ID = "your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN = "your-cloudflare-api-token"
